{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fidoria",
  "workers_dev": true,
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "vars": {
    "RESEND_FROM_EMAIL": "FIDORIA Web <onboarding@resend.dev>",
    "PAYPAL_ENV": "sandbox"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fidoria-commerce",
      "database_id": "e15e7741-a596-4391-bc8a-e71d944d5309",
      "migrations_dir": "drizzle"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "shopfidoria.com",
      "custom_domain": true
    },
    {
      "pattern": "www.shopfidoria.com",
      "custom_domain": true
    },
    {
      "pattern": "fidoria.cl",
      "custom_domain": true
    },
    {
      "pattern": "www.fidoria.cl",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
